@base <https://home.bawue.de/~horsch/teaching/inf230/lab/data#>.

# these are always needed
#
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xs: <http://www.w3.org/2001/XMLSchema#>.

# common for annotating datasets: DCAT and Dublin Core (DC)
#
@prefix dcterms: <http://purl.org/dc/terms/>.

@prefix a: <https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-oppgaave-A-en.html#>.

# some basic metadata
#
<https://home.bawue.de/~horsch/teaching/inf230/material/p1.ttl> a owl:Ontology;
   dcterms:title "Drafting problem 1"@en;
   dcterms:license <https://creativecommons.org/licenses/by-nc-sa/4.0/>.





### OperatingEquipment ###

a:OperatingEquipment a owl:Class.




### Train ###

a:Train a owl:Class;
   rdfs:subClassOf a:OperatingEquipment;
   skos:definition "piece of operating equipment that has a number of coaches"@en.



a:Coaches a owl:DatatypeProperty;
   rdfs:domain a:Train;
   rdfs:range xs:integer.



### Services ###

a:Services a owl:Class.

### TrainService ###

a:TrainService a owl:Class;
   rdfs:subClassOf a:Services;
   skos:definition "service that is run by a train, with an origin and a destination that are train stations"@en.

   rdfs:subClassOf a [
      a owl:Restriction;
      owl:onProperty a:IsRunBy;
      owl:someValuesFrom a:Train
   ].

   rdfs:subClassOf a [
      a owl:Restriction;
      owl:onProperty a:Origin;
      owl:someValuesFrom a:TrainStation
   ].

   rdfs:subClassOf a [
      a owl:Restriction;
      owl:onPoperty a:Destination;
      owl:someValuesFrom a:TrainStation
   ].


a:ArrivalTime a owl:DatatypeProperty;
   rdfs:domain a:TrainService;
   rdfs:range xs:dateTime.

a:DepartureTime a owl:DatatypeProperty;
   rdfs:domain a:TrainService;
   rdfs:range xs:dateTime.

a:Destination a owl:DatatypeProperty;
   rdfs:domain a:TrainService;
   rdfs:range a:TrainStation.

a:Origin a owl:DatatypeProperty;
   rdfs:domain a:TrainService;
   rdfs:range a:TrainStation.



a:MakesUseOf a owl:ObjectProperty;
   rdfs:domain a:Services;
   rdfs:range a:OperatingEquipment.

a:IsRunBy a owl:ObjectProperty;
   rdfs:SubPropertyOf a:MakesUseOf;
   rdfs:domain a:Services;
   rdfs:range a:OperatingEquipment.

a:Runs a owl:ObjectProperty;
   owl:inverseOf a:IsRunBy.


# [
#    a owl:Class;
#    a owl:interSectionOf (
#       a:OperatingEquipment;
#       [
#          a:owl:Restriction;
#          a:owl:onProperty a:Runs;
#          a:owl:someValuesFrom a:TrainService
#       ]
#    )
# ] rdfs:subClassOf a:Train.


### Place ###

a:Place a owl:Class.

### Train station ###

a:TrainStation a owl:Class;
   rdfs:subClassOf a:Place;
   skos:definition "place where trains stop and train services can originate or terminate"@en.

a:TrainStationname a owl:DatatypeProperty;
   rdfs:domain a:TrainStation;
   rdfs:range xs:string.





### ABOX ###

<Moss> a a:TrainStation.

<Stabekk> a a:TrainStation.

<Train> a a:Train;
   a:Coaches "8"^^xs:integer.


<Service> a a:TrainService;
   a:Origin <Moss>;
   a:Destination <Stabekk>;
   a:DepartureTime "2026-09-16T09:54:00"^^xs:dateTime;
   a:ArrivalTime "2026-09-16T10:49:00"^^xs:dateTime.

<Service> a:MakesUseOf <Train>.





