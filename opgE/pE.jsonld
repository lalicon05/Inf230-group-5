{
  "@context": {
    "e": "https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-oppgaave-E.html#",
    "xs": "http://www.w3.org/2001/XMLSchema#",
    "Name": {
      "@id": "e:Name",
      "@language": "en"
    },
    "HasMeasurement": {
      "@id": "e:HasMeasurement",
      "@type": "@id"
    },
    "MeasurementOf": {
      "@id": "e:MeasurementOf",
      "@type": "@id"
    },
    "SIUnit": "e:SIUnit",
    "MeasuredValue": {
      "@id": "e:MeasuredValue",
      "@type": "xs:float"
    },
    "MinimumValue": {
      "@id": "e:MinimumValue",
      "@type": "xs:float"
    },
    "MaximumValue": {
      "@id": "e:MaximumValue",
      "@type": "xs:float"
    },
    "UncertaintyAbsolute": {
      "@id": "e:UncertaintyAbsolute",
      "@type": "xs:float"
    },
    "UncertaintyPercent": {
      "@id": "e:UncertaintyPercent",
      "@type": "xs:float"
    },
    "ErrorAbsolute": {
      "@id": "e:ErrorAbsolute",
      "@type": "xs:float"
    },
    "ErrorPercent": {
      "@id": "e:ErrorPercent",
      "@type": "xs:float"
    }
  },
  "@graph": [
    {
      "@id": "e:Table",
      "@type": "e:PhysicalThing",
      "e:Name": "Table",
      "e:HasMeasurement": [
        "e:TableWidth",
        "e:TableDepth",
        "e:TableHeight",
        "e:TableMass"
      ]
    },
    {
      "@id": "e:Room",
      "@type": "e:PhysicalThing",
      "e:Name": "Room",
      "e:HasMeasurement": [
        "e:RoomWidth",
        "e:RoomDepth",
        "e:RoomTemperature"
      ]
    },
    {
      "@id": "e:TableWidth",
      "e:Name": "TableWidth",
      "e:MeasurementOf": "e:Table",
      "e:MeasuredValue": 1.6,
      "e:UncertaintyAbsolute": 0.001,
      "e:ErrorAbsolute": 0.002,
      "@type": "e:Length",
      "e:SIUnit": "m"
    },
    {
      "@id": "e:TableDepth",
      "e:Name": "TableDepth",
      "e:MeasurementOf": "e:Table",
      "e:MeasuredValue": 0.8,
      "e:UncertaintyAbsolute": 0.001,
      "e:ErrorAbsolute": 0.001,
      "@type": "e:Length",
      "e:SIUnit": "m"
    },
    {
      "@id": "e:TableHeight",
      "e:Name": "TableHeight",
      "e:MeasurementOf": "e:Table",
      "e:MeasuredValue": 0.75,
      "e:UncertaintyAbsolute": 0.001,
      "e:ErrorAbsolute": 0.0,
      "@type": "e:Length",
      "e:SIUnit": "m"
    },
    {
      "@id": "e:TableMass",
      "e:Name": "TableMass",
      "e:MeasurementOf": "e:Table",
      "e:MeasuredValue": 25.0,
      "e:UncertaintyAbsolute": 0.1,
      "e:ErrorAbsolute": 0.2,
      "@type": "e:Mass",
      "e:SIUnit": "kg"
    },
    {
      "@id": "e:RoomWidth",
      "e:Name": "RoomWidth",
      "e:MeasurementOf": "e:Room",
      "e:MeasuredValue": 4.0,
      "e:UncertaintyAbsolute": 0.01,
      "e:ErrorAbsolute": 0.02,
      "@type": "e:Length",
      "e:SIUnit": "m"
    },
    {
      "@id": "e:RoomDepth",
      "e:Name": "RoomDepth",
      "e:MeasurementOf": "e:Room",
      "e:MeasuredValue": 3.0,
