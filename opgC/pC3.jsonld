        "MaximumValue": { "@id": "c:MaximumValue", "@type": "xs:float" },
        "UncertaintyAbsolute": { "@id": "c:UncertaintyAbsolute", "@type": "xs:float" },
        "UncertaintyPercent": { "@id": "c:UncertaintyPercent", "@type": "xs:float" },
        "ErrorAbsolute": { "@id": "c:ErrorAbsolute", "@type": "xs:float" },
        "ErrorPercent": { "@id": "c:ErrorPercent", "@type": "xs:float" }
    },
