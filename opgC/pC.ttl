@base <https://home.bawue.de/~horsch/teaching/inf230/lab/data#>.

# these are always needed
#
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xs: <http://www.w3.org/2001/XMLSchema#>.

# common for annotating datasets: Dublin Core (DC)
#
@prefix dcterms: <http://purl.org/dc/terms/>.

@prefix c: <https://home.bawue.de/~horsch/teaching/inf230/lab/inf230-oppgaave-C.html#>.

# some basic metadata
#
<https://home.bawue.de/~horsch/teaching/inf230/material/group5.ttl> a owl:Ontology;
   dcterms:title "Uncertainties and errors in physical quantities, group 5"@en;
   dcterms:license <https://creativecommons.org/licenses/by-nc-sa/4.0/>.



### PhysicalThing ###

c:PhysicalThing a owl:Class;
   skos:definition "physical object that has at least one measurement"@en;
   rdfs:comment "any measurable physical object"@en;
   rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty c:HasMeasurement;
    owl:minCardinality "1"
   ];
   rdfs:subClassOf [
    a owl:Restriction;
    owl:onProperty c:Name;
    owl:minCardinality "1"
   ].



### Measurement ###

c:Measurement a owl:Class;
   skos:definition "quality of a physical thing that has been measured, expressed by a value and a unit"@en;
    rdfs:subClassOf [
      a owl:Restriction;
      owl:onProperty c:MeasurementOf;
      owl:cardinality "1"
   ];
   rdfs:subClassOf [
      a owl:Restriction;
      owl:onProperty c:UncertaintyAbsolute;
      owl:cardinality "1"
   ];
   rdfs:subClassOf [
      a owl:Restriction;
      owl:onProperty c:MeasuredValue;
      owl:cardinality "1"
   ];
   rdfs:subClassOf [
      a owl:Restriction;
      owl:onProperty c:ErrorAbsolute;
      owl:cardinality "1"
   ].



### SIMeasurement ###

c:SIMeasurement a owl:Class;
   rdfs:subClassOf c:Measurement;
   skos:definition "measurement of one of the seven SI specs"@en;
      rdfs:subClassOf [
      a owl:Restriction;
      owl:onProperty c:SIUnit;
      owl:cardinality "1"
   ].


### Length ###

c:Length a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:definition "base measurement of the physical thing along one dimension"@en.

### Mass ###

c:Mass a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:definition "base measurement of the amount of matter in a physical thing"@en.

### Time ###

c:Time a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:definition "base measurement of a duration"@en.

### ElectricCurrent ###

c:ElectricCurrent a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:definition "base measurement of the electric charge through a physical thing"@en.

### Temperature ###

c:Temperature a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:definition "base measurement of the thermal energy"@en.

### AmountOfSubstance ###

c:AmountOfSubstance a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:altLabel "mol"@en;
   skos:definition "base measurement of the number of entities"@en.

### LuminousIntensity ###

c:LuminousIntensity a owl:Class;
   rdfs:subClassOf c:SIMeasurement;
   skos:altLabel "light level"@en;
   skos:definition "light emitted by a physical thing"@en.


### Datatype properties ###

c:MeasuredValue a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:BoundValue a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:MaximumValue a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:MinimumValue a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:UncertaintyAbsolute a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:UncertaintyPercent a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:ErrorAbsolute a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:ErrorPercent a owl:DatatypeProperty;
    rdfs:domain c:Measurement;
    rdfs:range xs:float.

c:SIUnit a owl:DatatypeProperty,
        owl:FunctionalProperty;
    rdfs:domain c:SIMeasurement;
    rdfs:range [
        a rdfs:Datatype;
        owl:oneOf (
            "m" "kg" "s" "A" "K" "mol" "cd"
        )
    ].

c:Name a owl:DatatypeProperty;
    rdfs:domain c:PhysicalThing;
    rdfs:range xs:string.
### Object Properties ###

c:HasMeasurement a owl:ObjectProperty;
   rdfs:domain c:PhysicalThing;
   rdfs:range c:Measurement.

c:MeasurementOf a owl:ObjectProperty,
        owl:FunctionalProperty;
   owl:inverseOf c:HasMeasurement.
   




### ========================= ABox ========================== ###

# length is a length measurement
# Width is a length measurement
# hight is a length measurement

# m is a mass measurement
# k is a temperature measurement

# table has length, breath, hight as measurements and mass
# waterbottle has length, breath, hight as measurements and mass
# room has length, breath, hight as measurements and temperature

### ABox ###

# backbone

c:Length a c:SIMeasurement;
   rdfs:label "length";
   skos:definition "length of a physical thing"@en;
   c:SIUnit "m".


c:Width a c:Length;
   rdfs:label "width";
   skos:definition "width of a physical thing"@en.

c:Depth a c:Length;
   rdfs:label "depth";
   skos:definition "depth of a physical thing"@en.

c:Height a c:Length;
   rdfs:label "height";
   skos:definition "height of a physical thing"@en.

c:Mass a c:SIMeasurement;
   rdfs:label "mass";
   skos:definition "mass of a physical thing"@en;
   c:SIUnit "kg".

c:Temperature a c:SIMeasurement;
   rdfs:label "temperature";
   skos:definition "temperature of a physical thing"@en;
   c:SIUnit "K".

# Things
d:Table a c:PhysicalThing;
   c:Name "table";
   rdfs:label "Table";
   c:HasMeasurement d:TableWidth, d:TableDepth, d:TableHeight, d:TableMass.

d:WaterBottle a c:PhysicalThing;
   c:Name "water bottle";
   rdfs:label "Water bottle (0.5 L, full)";
   c:HasMeasurement d:BottleHeight, d:BottleMass.

d:Room a c:PhysicalThing;
   c:Name "room";
   rdfs:label "Room";
   c:HasMeasurement d:RoomWidth, d:RoomDepth, d:RoomTemperature.

# Table measurements
d:TableWidth a c:Width;
   rdfs:label "Table width";
   c:MeasurementOf d:Table;
   c:MeasuredValue "1.600"^^xs:float;
   c:UncertaintyAbsolute "0.001"^^xs:float;
   c:UncertaintyPercent "0.0625"^^xs:float;
   c:ErrorAbsolute "0.002"^^xs:float;
   c:ErrorPercent "0.125"^^xs:float.

d:TableDepth a c:Depth;
   rdfs:label "Table depth";
   c:MeasurementOf d:Table;
   c:MeasuredValue "0.800"^^xs:float;
   c:UncertaintyAbsolute "0.001"^^xs:float;
   c:UncertaintyPercent "0.125"^^xs:float;
   c:ErrorAbsolute "0.001"^^xs:float;
   c:ErrorPercent "0.125"^^xs:float.

d:TableHeight a c:Height;
   rdfs:label "Table height";
   c:MeasurementOf d:Table;
   c:MeasuredValue "0.750"^^xs:float;
   c:UncertaintyAbsolute "0.001"^^xs:float;
   c:UncertaintyPercent "0.133"^^xs:float;
   c:ErrorAbsolute "0.0"^^xs:float;
   c:ErrorPercent "0.0"^^xs:float.

d:TableMass a c:Mass;
   rdfs:label "Table mass";
   c:MeasurementOf d:Table;
   c:MeasuredValue "25.0"^^xs:float;
   c:UncertaintyAbsolute "0.1"^^xs:float;
   c:UncertaintyPercent "0.4"^^xs:float;
   c:ErrorAbsolute "0.2"^^xs:float;
   c:ErrorPercent "0.806"^^xs:float.

# Water bottle measurements
d:BottleHeight a c:Height;
   rdfs:label "Bottle height";
   c:MeasurementOf d:WaterBottle;
   c:MeasuredValue "0.210"^^xs:float;
   c:UncertaintyAbsolute "0.001"^^xs:float;
   c:UncertaintyPercent "0.476"^^xs:float;
   c:ErrorAbsolute "0.001"^^xs:float;
   c:ErrorPercent "0.476"^^xs:float.

d:BottleMass a c:Mass;
   rdfs:label "Bottle mass";
   c:MeasurementOf d:WaterBottle;
   c:MeasuredValue "0.530"^^xs:float;
   c:UncertaintyAbsolute "0.005"^^xs:float;
   c:UncertaintyPercent "0.943"^^xs:float;
   c:ErrorAbsolute "0.010"^^xs:float;
   c:ErrorPercent "1.923"^^xs:float.

# Room measurements
d:RoomWidth a c:Width;
   rdfs:label "Room width";
   c:MeasurementOf d:Room;
   c:MeasuredValue "4.00"^^xs:float;
   c:UncertaintyAbsolute "0.01"^^xs:float;
   c:UncertaintyPercent "0.25"^^xs:float;
   c:ErrorAbsolute "0.02"^^xs:float;
   c:ErrorPercent "0.503"^^xs:float.

d:RoomDepth a c:Depth;
   rdfs:label "Room depth";
   c:MeasurementOf d:Room;
   c:MeasuredValue "3.00"^^xs:float;
   c:UncertaintyAbsolute "0.01"^^xs:float;
   c:UncertaintyPercent "0.333"^^xs:float;
   c:ErrorAbsolute "0.01"^^xs:float;
   c:ErrorPercent "0.332"^^xs:float.

d:RoomTemperature a c:Temperature;
   rdfs:label "Room temperature (22 C)";
   c:MeasurementOf d:Room;
   c:MeasuredValue "295.15"^^xs:float;
   c:UncertaintyAbsolute "0.5"^^xs:float;
   c:UncertaintyPercent "0.169"^^xs:float;
   c:ErrorAbsolute "0.3"^^xs:float;
   c:ErrorPercent "0.102"^^xs:float.

#<TableLength> a c:Length;
#   c:SIUnit "m";
#   c:MeasuredValue "30.4";
#   c:UncertaintyAbsolute "0.7";
#   c:ErrorAbsolute "0";
#   c:ErrorPercent "0".

#
# 12 individuals (3 PhysicalThing + 9 Measurement), 18 relationships
# (c:HasMeasurement / c:MeasurementOf, 9 each). Individuals live in the
# abox: namespace, kept separate from the c: (TBox) namespace.

### Physical things ###

abox:Laptop a c:PhysicalThing;
   c:Name: "Laptop";
   c:HasMeasurement abox:Laptop_Length, abox:Laptop_Width, abox:Laptop_Height, abox:Laptop_Mass;

# measurements ==================================================
abox:Laptop_Length a c:Length;
   c:MeasurementOf abox:Laptop;
   c:SIUnit "m";
   c:MeasuredValue "0.30"^^xs:float;
   c:MinimumValue "0.29"^^xs:float;
   c:MaximumValue "0.31"^^xs:float;
   c:UncertaintyAbsolute "0.02"^^xs:float;
   c:UncertaintyPercent "0.667"^^xs:float;
   c:ErrorAbsolute "0.01"^^xs:float;
   c:ErrorPercent "0.033"^^xs:float;